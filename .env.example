# Local first-stage analysis
SAFEMATE_URL_MODEL_PATH=models/url_char_model.joblib
SAFEMATE_URL_MODEL_KIND=char

# Optional OpenAI follow-up (default off). Only 1|true|yes|on (case-insensitive) enables it.
SAFEMATE_OPENAI_FOLLOWUP_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROVIDER_CONTRACT_ATTESTATION_PATH=
OPENAI_PROVIDER_CONTRACT_ATTESTATION_SHA256=
OPENAI_VECTOR_STORE_ID=
OPENAI_VECTOR_INVENTORY_ATTESTATION_PATH=
OPENAI_VECTOR_INVENTORY_ATTESTATION_SHA256=

# Operator-only publication and live-integration gates. Keep blank in ordinary CI.
# Publication requires the exact literal SAFEMATE_VECTOR_STORE_PUBLISH=YES.
# Live tests require the exact literals RUN_OPENAI_INTEGRATION=1 and OPENAI_INTEGRATION_COST_ACK=YES.
# CI live tests additionally require the exact literal OPENAI_INTEGRATION_TRUSTED_RUNNER=1.
SAFEMATE_VECTOR_STORE_PUBLISH=
SAFEMATE_PROVIDER_REVIEWER_ID=
OPENAI_SDK_VERSION=
RUN_OPENAI_INTEGRATION=
OPENAI_INTEGRATION_COST_ACK=
OPENAI_INTEGRATION_TRUSTED_RUNNER=
OPENAI_INTEGRATION_FILE_NAME=
